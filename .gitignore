# ---- 运行时数据（保留 data 目录本身，内容不入库）----
data/*
!data/.gitkeep

# ---- 开发工具生成缓存（行政区划数据生成中间产物）----
.geo_cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- 本地环境变量（可放 MAPTRACK_PORT）----
.env

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- 日志与临时文件 ----
*.log
*.tmp
