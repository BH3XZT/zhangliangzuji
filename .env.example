# 宿主机访问端口（默认 8000；飞牛 NAS 上我们实际使用 18000）
MAPTRACK_PORT=8000

# ---- 城市自驾等时圈（可选 profile）----
# Valhalla 官方 scripted 镜像
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
# Valhalla 构建/服务线程；8G 内存建议 2，16G 可设 4
VALHALLA_THREADS=2
# build_tiles.sh 的单次构建内存上限
VALHALLA_BUILD_MEMORY=4g
# 时区库需要访问 GitHub；国内 NAS 建议 False（等时圈不依赖时区）
VALHALLA_BUILD_TIMEZONES=False
# 默认区域：太原周边 4 省，约 276MB
REGIONS="shanxi hebei henan shaanxi"
# 水系 / 城市点类型
WATERWAYS=river,canal
PLACES=city,town
