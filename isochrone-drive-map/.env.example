# 对外访问端口（浏览器访问 http://NAS_IP:8080）
WEB_PORT=8080

# Valhalla 官方 scripted 镜像
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest

# Valhalla 构建/服务线程数；8G 内存的 NAS 建议 2，16G 可设 4
VALHALLA_THREADS=2

# build_tiles.sh 使用的内存上限
VALHALLA_BUILD_MEMORY=4g

# 是否构建时区库（需要访问 GitHub 下载 shapefile；国内 NAS 建议 False）
VALHALLA_BUILD_TIMEZONES=False

# 默认区域：太原周边（山西/河北/河南/陕西），约 276MB
# 如需要 300km 北侧范围，可加 inner-mongolia；但会显著增加构建时间/内存
REGIONS="shanxi hebei henan shaanxi"

# 水体类型（river,canal；可加 stream，但数据量明显增大）
WATERWAYS=river,canal

# 城市点类型
PLACES=city,town

# PyPI 镜像（构建 backend 时使用；可换成阿里云/官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
